DATABASE_URL=postgresql://oj:ojpass@localhost:5432/oj?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CORS_ORIGIN=http://localhost:5173
DATA_DIR=./data
ADMIN_PASSWORD=
COOKIE_SECURE=false
TRUST_PROXY=false
JWT_SECRET_MIN_LENGTH=32
MAX_JSON_BODY_BYTES=2097152
MAX_CODE_SIZE=100000
MAX_RUN_INPUT_SIZE=50000
MAX_STATEMENT_SIZE=200000
MAX_SAMPLE_SIZE=50000
MAX_TESTCASE_SIZE=200000
MAX_TEXT_ANSWER_SIZE=50000
MAX_GENERATOR_CODE_SIZE=100000
MAX_SOLUTION_CODE_SIZE=100000
MAX_PROBLEM_TITLE_LENGTH=120
MAX_CONTEST_TITLE_LENGTH=120
MAX_USERNAME_LENGTH=32
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128
MAX_TIME_LIMIT_MS=10000
MAX_MEMORY_LIMIT_MB=512
MAX_TESTCASE_COUNT=200
RUN_WAIT_TIMEOUT_MS=60000
RUN_QUEUE_NAME=run-queue
JUDGE_QUEUE_NAME=submission-queue
COMPILE_TIMEOUT_MS=20000
COMPILE_MEMORY_LIMIT_MB=1024
RUN_WORKER_CONCURRENCY=2
JUDGE_WORKER_CONCURRENCY=4
MAX_GENERATED_TESTCASE_COUNT=30
SANDBOX_VOLUME_SIZE_MB=256
SANDBOX_MAX_FILE_BYTES=16777216
SANDBOX_ALLOW_UNLIMITED_VOLUME_FALLBACK=false
JUDGE_IMAGE_ALLOWLIST=oj-runner:latest
