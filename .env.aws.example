# AWS production environment
# Copy to .env.aws and set strong secrets/endpoints.

# RDS / ElastiCache endpoints
DATABASE_URL=postgresql://oj:REPLACE_DB_PASSWORD@your-rds-endpoint:5432/oj?schema=public
REDIS_URL=redis://your-elasticache-endpoint:6379

# Security
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=
TRUST_PROXY=true
JWT_SECRET_MIN_LENGTH=32

# CORS: set the exact frontend origin(s), comma-separated
CORS_ORIGIN=https://oj.example.com

# Server binding on EC2 host (use 0.0.0.0 only when needed)
SERVER_BIND_IP=127.0.0.1

# Shared filesystem path between server and worker
DATA_DIR_HOST=/srv/oj/data

# Queue names
RUN_QUEUE_NAME=run-queue
JUDGE_QUEUE_NAME=submission-queue

# Judge image
JUDGE_IMAGE=oj-runner:latest
JUDGE_IMAGE_ALLOWLIST=oj-runner:latest

# Worker concurrency
RUN_WORKER_CONCURRENCY=2
JUDGE_WORKER_CONCURRENCY=4

# Limits
MAX_TIME_LIMIT_MS=10000
MAX_MEMORY_LIMIT_MB=512
MAX_TESTCASE_COUNT=200
MAX_GENERATED_TESTCASE_COUNT=30
COMPILE_TIMEOUT_MS=20000
COMPILE_MEMORY_LIMIT_MB=1024
SANDBOX_VOLUME_SIZE_MB=256
SANDBOX_MAX_FILE_BYTES=16777216
SANDBOX_ALLOW_UNLIMITED_VOLUME_FALLBACK=false
SANDBOX_USE_TMPFS=false
